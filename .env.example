# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.4.10.118,10.3.10.226
USE_SQLITE=False

# MariaDB / MySQL (matches docker-compose service `db`)
MYSQL_DATABASE=smart_finishing_floor
MYSQL_USER=sff
MYSQL_PASSWORD=sff
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root

# Second DB on same host (read-only external tables)
MYSQL_AUTOMATION_DATABASE=mbm_automation

# HR — cuttingedgedb.hr_as_basic_info (operator name & picture)
MYSQL_CUTTINGEDGE_DATABASE=cuttingedgedb
# Prepended to hr_as_basic_info.as_pic (e.g. /assets/images/employee/...)
HR_PHOTO_BASE_URL=https://erp.mbm.group
# Optional overrides (default: same as MYSQL_* above)
# MYSQL_AUTOMATION_HOST=
# MYSQL_AUTOMATION_PORT=
# MYSQL_AUTOMATION_USER=
# MYSQL_AUTOMATION_PASSWORD=

# Redis / Celery / Channels
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# External camera / edge app → POST /api/camera/data/
CAMERA_INGEST_API_KEY=change-me-camera-ingest-key

# Live CCTV for finishing dashboard (RTSP — API converts to JPEG snapshots)
# Dahua playback → realmonitor; Hikvision playback → strips starttime/endtime from /Streaming/tracks/...
CAMERA_RTSP_LIVE_URL=rtsp://test:Mbm1983!@10.4.2.11:554/Streaming/Channels/1201
# Prefer Hikvision substream (…02) for lower latency when true
CAMERA_RTSP_LOW_LATENCY=True
# CAMERA_RTSP_URL=rtsp://test:Mbm1983!@10.4.2.11:554/Streaming/tracks/1201?starttime=20260616T110530Z&endtime=20260616T111000Z

# Per-zone live CCTV (optional). Stations listed in CAMERA_ZONE_<N>_STATIONS
# (workstation ids) use CAMERA_ZONE_<N>_RTSP_URL; everything else falls back
# to CAMERA_RTSP_LIVE_URL. Add more zones by incrementing N.
# CAMERA_ZONE_1_STATIONS=1,2,3,4
# CAMERA_ZONE_1_RTSP_URL=rtsp://user:pass@host:554/Streaming/tracks/101

# CORS (Vite default)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dev ports (when ERP uses 8000 on LAN):
# - Django:  python manage.py runserver 0.0.0.0:8001
# - Vite:    npm run dev  (proxies /api → 127.0.0.1:8001 via frontend/.env.development)
# - Camera:  http://10.4.10.118:8001/api/camera/data/bulk/

# Logging
LOG_LEVEL=INFO
