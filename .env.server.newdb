# Server deployment (172.16.101.5) — copied to /opt/smart_finishing_floor/.env
# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,172.16.101.5,backend
USE_SQLITE=False

# External MariaDB (new DB server) — no local db container in prod
MYSQL_DATABASE=smartfinishinfloor
MYSQL_USER=dbadmin
MYSQL_PASSWORD=6QjYxHk4mkDpFngKmV
MYSQL_HOST=10.135.50.27
MYSQL_PORT=3336
MYSQL_ROOT_PASSWORD=6QjYxHk4mkDpFngKmV

# Laravel-style aliases (same server)
DB_CONNECTION=mysql
DB_HOST=10.135.50.27
DB_PORT=3336
DB_DATABASE=cuttingedgedb
DB_USERNAME=dbadmin
DB_PASSWORD=6QjYxHk4mkDpFngKmV

# Second DB — same host, automation tables (fabricdifact, sewing_log)
MYSQL_AUTOMATION_DATABASE=mbm_automation

# HR master (employee name & photo for line dashboard)
MYSQL_CUTTINGEDGE_DATABASE=cuttingedgedb
HR_PHOTO_BASE_URL=https://erp.mbm.group

# Redis / Celery / Channels — compose service `redis`
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# External camera app → POST /api/camera/data/  (header: X-API-Key)
CAMERA_INGEST_API_KEY=sff-camera-ingest-2026

# Live CCTV for finishing dashboard (RTSP → JPEG snapshots on API server)
CAMERA_RTSP_LOW_LATENCY=True
CAMERA_RTSP_LIVE_URL=rtsp://test:Mbm1983!@192.168.4.5:554/Streaming/Channels/301

# Per-zone live CCTV: 5 zones x 5 stations (workstation ids 1-25; extras roll into zone 5)
CAMERA_ZONE_1_STATIONS=1,2,3,4,5
CAMERA_ZONE_1_CAMERA_ID=CAM-02
CAMERA_ZONE_1_RTSP_URL=rtsp://test:Mbm1983!@192.168.4.5:554/Streaming/Channels/201
CAMERA_ZONE_2_STATIONS=6,7,8,9,10
CAMERA_ZONE_2_RTSP_URL=rtsp://test:Mbm1983!@192.168.4.5:554/Streaming/Channels/401
CAMERA_ZONE_3_STATIONS=11,12,13,14,15
CAMERA_ZONE_3_RTSP_URL=rtsp://test:Mbm1983!@192.168.4.5:554/Streaming/Channels/501
CAMERA_ZONE_4_STATIONS=16,17,18,19,20
